--- !u!114 &1478228149
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1478228147}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e46a173c50f3144428a126e08f1527b5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  startPanel: {fileID: 4924235}
  dialoguePanel: {fileID: 1370110220}
  nameText: {fileID: 362654563}
  dialogueText: {fileID: 1635607393}
  introCutscene: {fileID: 1929496656}
  lines:
  - speaker: "\u5E2B\u7236"
    text: "\u5F92\u5152\uFF0C\u70BA\u5E2B\u525B\u525B\u5728\u6B63\u5EF3\u8207\u4E3B\u5BB6\u8001\u723A\u54C1\u8336\u8AC7\u6B63\u4E8B\u3002\r\n\u7B97\u7B97\u6642\u9593\uFF0C\u70BA\u5E2B\u4EA4\u4EE3\u4F60\u5148\u9032\u4F86\u5E03\u7F6E\u7684\u6CD5\u5834\u3001\u5B89\u653E\u51A5\u5A5A\u6CD5\u5668\u7684\u9032\u5EA6\uFF0C\u61C9\u8A72\u90FD\u59A5\u7576\u4E86\u5427\uFF1F\r\n"
  - speaker: "\u5F92\u5F1F"
    text: "\u5E2B\u3001\u5E2B\u7236\u2026\u2026\u59A5\u3001\u59A5\u7576\u662F\u59A5\u7576\u4E86\u2026\u2026\u53EA\u662F\u4E2D\u9593\u51FA\u4E86\u4E00\u9EDE\u9EDE\u2026\u2026\u975E\u5E38\u5FAE\u5C0F\u7684\u5C0F\u610F\u5916\u2026\u2026\r\n"
  - speaker: "\u5E2B\u7236"
    text: "\u610F\u5916\uFF1F\u70BA\u5E2B\u540D\u9707\u56DB\u65B9\uFF0C\u4E3B\u5BB6\u624D\u7279\u5730\u8A2D\u5BB4\u3001\u5099\u4E86\u91CD\u91D1\u8ACB\u6211\u4F86\u4E3B\u6301\u9019\u5834\u51A5\u5A5A\u6CD5\u4E8B\u3002\u4F60\u9032\u53BB\u64FA\u500B\u6CD5\u5668\uFF0C\u80FD\u51FA\u4EC0\u9EBC\u610F\u5916\uFF1F"
  - speaker: "\u5F92\u5F1F"
    text: "\u5C31\u2026\u2026\u525B\u525B\u88E1\u9762\u7684\u9670\u98A8\u7A81\u7136\u597D\u5927\uFF0C\u6211\u4E00\u5687\u5230\uFF0C\u8173\u6ED1\u6454\u4E86\u4E00\u8DE4\uFF0C\u7D50\u679C\u628A\u684C\u4E0A\u7684\u881F\u71ED\u649E\u5012\u3001\u4F9B\u54C1\u7FFB\u4E86\u4E00\u5730\u2026\u2026\u597D\u50CF\u9084\u4E0D\u5C0F\u5FC3\u628A\u65B0\u5A18\u7684\u795E\u4E3B\u724C\u7D66\u8E22\u5230\u5E8A\u5E95\u4E0B\u4E86\u2026"
  - speaker: "\u5E2B\u7236"
    text: "\u4F60\u9019\u5B7D\u5F92\uFF01\u90A3\u662F\u53B2\u9B3C\u7684\u6CD5\u5834\uFF01\u4F60\u628A\u4EBA\u5BB6\u7684\u73FE\u5834\u641E\u6210\u9019\u6A23\uFF0C\u662F\u5ACC\u547D\u592A\u9577\uFF0C\u9084\u662F\u60F3\u76F4\u63A5\u7559\u4E0B\u4F86\u7576\u65B0\u90CE\uFF1F\uFF01"
  - speaker: "\u5F92\u5F1F"
    text: "\u5E2B\u7236\u6211\u932F\u4E86\uFF01\u4E3B\u5BB6\u8001\u723A\u7B49\u4E00\u4E0B\u5C31\u8981\u904E\u4F86\u5DE1\u8996\u4E86\uFF0C\u8981\u662F\u88AB\u770B\u5230\u5C31\u5B8C\u4E86\uFF01\u60A8\u9053\u6CD5\u9AD8\u6DF1\uFF0C\u6C42\u6C42\u60A8\u5FEB\u9032\u53BB\u5E6B\u5FD9\u4FEE\u5FA9\u5427\uFF0C\u5F1F\u5B50\u5728\u5916\u9762\u5E6B\u60A8\u628A\u98A8\uFF01"
  - speaker: "\u5E2B\u7236"
    text: "\u2026\u2026\u8981\u4E0D\u662F\u70BA\u4E86\u6211\u4E00\u4E16\u82F1\u540D\uFF0C\u9084\u6709\u4E3B\u5BB6\u7D66\u7684\u90A3\u7B46\u512A\u6E25\u916C\u52DE\uFF0C\u70BA\u5E2B\u771F\u60F3\u628A\u4F60\u76F4\u63A5\u9396\u5728\u88E1\u9762\u3002\r\n"
  - speaker: "\u5E2B\u7236"
    text: "\u807D\u597D\u4E86\uFF0C\u4F60\u5728\u9580\u53E3\u7D66\u6211\u6B7B\u6B7B\u5B88\u8457\uFF01\u8981\u662F\u4E3B\u5BB6\u8001\u723A\u8D70\u904E\u4F86\uFF0C\u4F60\u60F3\u76E1\u8FA6\u6CD5\u4E5F\u8981\u7D66\u6211\u62D6\u5EF6\u6642\u9593\uFF0C\u807D\u61C2\u6C92\u6709\uFF1F\uFF01\r\n"
  - speaker: "\u5F92\u5F1F"
    text: "\u807D\u61C2\u4E86\uFF01\u807D\u61C2\u4E86\uFF01\u5E2B\u7236\u60A8\u653E\u5FC3\uFF0C\u6211\u4E00\u5B9A\u7528\u751F\u547D\u64CB\u4F4F\u4E3B\u5BB6\uFF01\r\n"
  - speaker: "\u5E2B\u7236"
